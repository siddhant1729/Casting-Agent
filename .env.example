# Copy to .env and fill in. .env is gitignored; this file is the committed
# reference for what the app reads.
#
#     cp .env.example .env
#
# Anything already exported in your shell wins over what is in .env, so a real
# environment variable is never silently overridden by a stale checkout.

# Enables semantic ranking. Without it the app falls back to word overlap,
# which is deliberately weak — see "The vocabulary gap" in the README.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Deployment only. Comma-separated browser origins allowed to call the API —
# the frontend's URL when it is served from somewhere else. Localhost (any
# port) and *.onrender.com are already allowed, so this is for a custom domain.
# ALLOWED_ORIGINS=https://casting.example.com

# Deployment only. Overrides where the API looks for the built frontend. When a
# frontend/dist is present the API serves the UI itself from the same origin;
# leave this unset for the two-service layout in render.yaml.
# FRONTEND_DIST=
