# Copy to .env and fill in. .env is gitignored; this file is the committed
# reference for what the app reads.
#
#     cp .env.example .env
#
# Anything already exported in your shell wins over what is in .env, so a real
# environment variable is never silently overridden by a stale checkout.

# Enables semantic ranking. Without it the app falls back to word overlap,
# which is deliberately weak — see "The vocabulary gap" in the README.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
